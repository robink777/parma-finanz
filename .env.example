# onOffice API-Zugang (Extras -> Einstellungen -> Benutzer -> API-Benutzer)
# Dedizierter API-Nutzer fuer dieses Web-Projekt, NICHT der MCP-Zugang.
ONOFFICE_API_TOKEN=
ONOFFICE_API_SECRET=

# Welches Feld/welcher Wert markiert eine Immobilie als "fuer die Webseite freigegeben".
# Default filtert auf Status (Status 1) = 1 (Active) und Vermarktungsart = Kauf
# (siehe README, Abschnitt "onOffice-Filter"). Status2 in diesem Account ist NICHT das Aktiv-Flag --
# "status2obj_aktiv" ist dort ein Systemplatzhalter ("nicht auswaehlen"), keine echte Belegung.
ONOFFICE_ESTATE_FILTER_FIELD=status
ONOFFICE_ESTATE_FILTER_VALUE=1

# Optional: loginName des onOffice-Users, dem eine Aufgabe fuer neue Leads zugewiesen wird
# (z.B. "Robin" - siehe Benutzerliste in onOffice). Leer lassen fuer Standard-Zuweisung.
ONOFFICE_TASK_ASSIGNEE_LOGIN=
