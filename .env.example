# onOffice API-Zugang (Extras -> Einstellungen -> Benutzer -> API-Benutzer)
# Dedizierter API-Nutzer fuer dieses Web-Projekt, NICHT der MCP-Zugang.
ONOFFICE_API_TOKEN=
ONOFFICE_API_SECRET=

# Welches Feld/welcher Wert markiert eine Immobilie als "fuer die Webseite freigegeben".
# Default filtert auf Status (Status 1) = 1 (Active) und Vermarktungsart = Kauf
# (siehe README, Abschnitt "onOffice-Filter"). Status2 in diesem Account ist NICHT das Aktiv-Flag --
# "status2obj_aktiv" ist dort ein Systemplatzhalter ("nicht auswaehlen"), keine echte Belegung.
ONOFFICE_ESTATE_FILTER_FIELD=status
ONOFFICE_ESTATE_FILTER_VALUE=1

# Optional: loginName des onOffice-Users, dem eine Aufgabe fuer neue Leads zugewiesen wird
# (z.B. "Robin" - siehe Benutzerliste in onOffice). Leer lassen fuer Standard-Zuweisung.
ONOFFICE_TASK_ASSIGNEE_LOGIN=

# Interner onOffice-Schluessel des Kontaktart-Werts "Interessent Parma Finanz" (Feld ArtDaten).
# Muss zuerst im onOffice-Backend als neue Auswahloption angelegt werden (existiert noch nicht) --
# siehe README, Abschnitt "Dublettenpruefung & Kontaktart". Leer lassen, bis der Wert existiert;
# ohne diese Variable wird die Kontaktart einfach nicht gesetzt.
ONOFFICE_KONTAKTART_FINANZ_KEY=

# SMTP-Zugang fuer den Versand des Kontaktformulars (siehe README, Abschnitt "E-Mail-Versand").
# SMTP_USER/SMTP_PASS = Login-Daten eines bestehenden Strato-Postfachs (z.B. info@parmafinanz.de).
SMTP_HOST=smtp.strato.de
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional, faellt sonst auf SMTP_USER zurueck:
MAIL_FROM=
# Optional, Default ist bereits info@parmafinanz.de:
MAIL_TO=
